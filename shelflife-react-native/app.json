{
  "expo": {
    "name": "Pantree",
    "slug": "pantree",
    "version": "0.1.0",
    "scheme": "pantree",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3EADB",
    "ios": {
      "bundleIdentifier": "com.convergent.pantree",
      "supportsTablet": false
    },
    "android": {
      "package": "com.convergent.pantree"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Pantree uses the camera to scan grocery receipts."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
